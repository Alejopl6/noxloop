{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "es2023"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "useUnknownInCatchVariables": false
  },
  "include": [
    "packages/engine/src/**/*.mjs",
    "packages/engine/bin/**/*.mjs",
    "packages/service/src/**/*.mjs",
    "packages/service/bin/**/*.mjs",
    "packages/vault/src/**/*.mjs",
    "packages/scanner/src/**/*.mjs",
    "packages/connections/src/**/*.mjs",
    "packages/store/src/**/*.mjs",
    "packages/core/src/**/*.mjs",
    "packages/adapters/src/**/*.mjs",
    "providers/**/*.mjs"
  ],
  "exclude": [
    "**/*.test.mjs",
    "node_modules",
    "apps"
  ]
}
