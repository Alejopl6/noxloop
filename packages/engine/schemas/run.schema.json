{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noxloop.dev/schemas/run.schema.json",
  "title": "Run",
  "description": "Estado persistido de una ejecucion. Es la fuente de verdad; la conversacion no.",
  "type": "object",
  "required": ["schemaVersion", "item", "tasks", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "milestoneId": { "type": ["string", "null"] },
    "projectId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "outOfScope": { "type": "array", "items": { "type": "string" }, "description": "Lo que el plan dejo afuera a proposito. Va al cuerpo del pull request." },
    "serializedBecause": { "type": ["string", "null"], "description": "Si el orden fue serial por una limitacion del gestor, aca queda el motivo. Va al pull request." },
    "item": {
      "type": "object",
      "required": ["id", "title", "level", "url", "provider"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "level": { "enum": ["epic", "feature", "story", "task"] },
        "url": { "type": "string" },
        "provider": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "baseBranch": { "type": ["string", "null"] },
        "prTarget": { "type": ["string", "null"] },
        "pr": { "type": ["string", "null"] },
        "providerStateWritten": {
          "type": ["string", "null"],
          "description": "El ultimo estado que el motor escribio en el ticket. Es lo que vuelve idempotente la escritura: relanzar no lo mueve dos veces."
        },
        "boardFields": { "type": ["object", "null"] }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repo", "title", "acceptance", "targetFiles", "testFiles", "tier", "dependsOn", "dependencyKind", "status", "attempts", "redVerified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "repo": { "type": "string" },
          "repoPath": {
            "type": ["string", "null"],
            "description": "Ruta absoluta del checkout del repositorio, copiada de la config al planificar. Es lo que usa el servicio para atribuir el run a un proyecto cuando no trae projectId."
          },
          "title": { "type": "string" },
          "acceptance": { "type": "string" },
          "targetFiles": { "type": "array", "items": { "type": "string" } },
          "testFiles": { "type": "array", "items": { "type": "string" } },
          "tier": { "enum": ["trivial", "small", "medium", "large"] },
          "specialist": { "type": ["string", "null"] },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "dependencyKind": { "enum": ["hard", "soft"] },
          "noTestsBecause": { "type": "string" },
          "status": {
            "enum": ["pending", "in_progress", "red", "green", "gated", "reviewed", "queued", "integrated", "blocked"]
          },
          "attempts": {
            "type": "object",
            "required": ["red", "green", "gate", "review"],
            "additionalProperties": false,
            "properties": {
              "red": { "type": "integer", "minimum": 0 },
              "green": { "type": "integer", "minimum": 0 },
              "gate": { "type": "integer", "minimum": 0 },
              "review": { "type": "integer", "minimum": 0 }
            }
          },
          "redVerified": {
            "type": "boolean",
            "description": "Solo se pone en true despues de una corrida real con exit code distinto de cero. Escribir texto no la concede."
          },
          "worktree": { "type": ["string", "null"] },
          "branch": { "type": ["string", "null"] },
          "sessionId": { "type": ["string", "null"] },
          "providerItemId": { "type": ["string", "null"] },
          "redEvidence": { "type": ["object", "null"], "description": "La corrida del test que fallo antes del cambio. Va al cuerpo del pull request: sin ella, el PR afirma el rojo y no lo puede mostrar." },
          "gateEvidence": {
            "type": ["object", "null"],
            "description": "Sin este objeto no hay veredicto. La transicion a gated lo exige con exitCode 0.",
            "required": ["command", "exitCode", "durationMs"],
            "properties": {
              "command": { "type": "string" },
              "exitCode": { "type": ["integer", "null"] },
              "durationMs": { "type": "integer" },
              "output": { "type": "string" },
              "timedOut": { "type": "boolean" },
              "ranAt": { "type": "string", "format": "date-time" }
            }
          },
          "addedTargets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "why"],
              "properties": { "path": { "type": "string" }, "why": { "type": "string" } }
            }
          },
          "lastFailure": { "type": ["string", "null"] },
          "gateFingerprint": { "type": ["string", "null"], "description": "La huella del ultimo fallo del gate, sin lo que cambia entre corridas. Sirve para cortar cuando dos intentos producen el mismo fallo." },
          "integratedAt": { "type": ["string", "null"], "format": "date-time" },
          "implementador": {
            "type": ["object", "null"],
            "description": "Quien implementa ESTA tarea si no es el implementador del recorrido: lo escribe un hand-off (spec 005, FR-007). null es el del recorrido.",
            "required": ["runtime"],
            "properties": {
              "runtime": { "type": "string" },
              "agente": { "type": ["string", "null"] }
            }
          },
          "retomarEn": {
            "enum": ["red", null],
            "description": "Donde retoma el driver una tarea reabierta por un hand-off: en red, con la evidencia del rojo que ya habia, para no repetir RED."
          },
          "handoffs": {
            "type": "array",
            "description": "Cada vez que la tarea paso de un implementador a otro: de quien, a quien, desde que estado y que presupuesto ya estaba agotado.",
            "items": {
              "type": "object",
              "required": ["at", "a", "estado"],
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "de": { "type": ["string", "null"] },
                "a": { "type": "string" },
                "agente": { "type": ["string", "null"] },
                "estado": { "type": "string" },
                "motivo": { "type": ["string", "null"] },
                "retomarEn": { "enum": ["red", null] },
                "presupuesto": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "spent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
