# Copia este archivo a `.env` en este mismo directorio antes de levantar nada.
#
#   cp .env.ejemplo .env
#   openssl rand -base64 32        # y pega el resultado en NANGO_ENCRYPTION_KEY
#   docker compose up -d
#
# No se versiona un `.env` real: el `.gitignore` de la raiz ya ignora `.env` y
# `.env.*`, con la excepcion de los `.example`. Este archivo se llama `.ejemplo`
# por la misma razon que el resto del proyecto esta en castellano, y por eso se
# declara aqui explicitamente que NO contiene ningun valor real.

# --- Obligatorio -------------------------------------------------------------

# El fix del bug del puerto. La imagen trae PORT=8080 horneado y sin esta linea
# el servidor escucha en 8080 mientras el compose expone 3003: no conecta nada.
SERVER_PORT=3003

# Clave de cifrado en reposo, 256 bits en base64: `openssl rand -base64 32`.
#
# SIN ELLA LAS CREDENCIALES SE GUARDAN EN CLARO en Postgres. Y no admite
# rotacion: cambiarla despues rompe el descifrado de todo lo ya guardado, sin
# camino de migracion publicado. Generala una vez, guardala en el llavero del
# sistema, y no la pierdas.
NANGO_ENCRYPTION_KEY=

# --- Base de datos -----------------------------------------------------------

NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango
NANGO_DB_SSL=false

# El puerto con el que Postgres se asoma a la maquina. NO hace falta para que
# esto funcione —los tres contenedores se hablan por su red interna— y el 5432
# por defecto choca con cualquier otro Postgres que ya este corriendo.
#
# MEDIDO EL PRIMER `docker compose up`: «Error response from daemon: ports are
# not available: exposing port TCP 0.0.0.0:5432 ... address already in use».
# El mensaje no menciona Nango, ni este archivo, ni que el puerto es
# prescindible: el operador se va a apagar su otra base de datos.
NANGO_DB_PORT=5442

# --- Direcciones -------------------------------------------------------------

# Define el callback de OAuth: <NANGO_SERVER_URL>/oauth/callback.
#
# ESTE VALOR ES UN CONTRATO CON CADA PROVEEDOR. Es la redirect URI que hay que
# registrar en la aplicacion OAuth de Linear, de Jira, de GitHub... Cambiarlo
# obliga a volver a registrarla en todas. Por eso el puerto se reserva y
# `preflight()` falla al arrancar si esta ocupado, en vez de buscar otro.
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003

FLAG_SERVE_CONNECT_UI=true
CONNECT_UI_PORT=3009
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009

# --- Acceso al panel ---------------------------------------------------------

# El panel esta ABIERTO por defecto a cualquiera que alcance la instancia.
# Se cierra con usuario y contrasena desde el primer arranque.
FLAG_AUTH_ENABLED=false
NANGO_DASHBOARD_USERNAME=
NANGO_DASHBOARD_PASSWORD=

# --- Registro ----------------------------------------------------------------

LOG_LEVEL=info
# Activarlo exige levantar ademas el servicio de busqueda, que son varios GB de
# memoria. Para lo que este producto hace con Nango, no compensa.
NANGO_LOGS_ENABLED=false
