{
  "$schema": "../packages/engine/schemas/config.schema.json",
  "version": 1,

  "provider": {
    "name": "fake",
    "module": "../providers/fake/index.mjs",

    "stateMap": {
      "todo": "Nuevo",
      "in_progress": "En curso",
      "blocked": "Bloqueado",
      "in_review": null,
      "done": null
    },

    "levelMap": {
      "Epica": "epic",
      "Feature": "feature",
      "Historia": "story",
      "Tarea": "task",
      "default": "story"
    }
  },

  "forge": {
    "kind": "github",
    "cli": "gh"
  },

  "identity": {
    "assignee": "noxloop[bot]",
    "mention": "@noxloop"
  },

  "repos": {
    "app": {
      "path": "~/proyects/app",
      "remote": "git@github.com:mi-org/app.git",
      "baseBranch": "main",
      "gate": "npm run lint && npm run typecheck && npm test && npm run build",
      "fastGate": "npm test",
      "runners": {
        "node": "node --test {file}"
      },
      "env": {
        "DATABASE_URL": "${TEST_DATABASE_URL:-postgres://app:app@localhost:5433/app_test}"
      },
      "gaps": []
    }
  },

  "limits": {
    "maxParallelTasks": 4,
    "maxParallelItems": 2,
    "maxCostUsd": 100,
    "phaseTimeoutMin": 30,
    "callsPerItem": 60,
    "stallRounds": 2,
    "pollIntervalSec": 120
  },

  "budgets": { "red": 2, "green": 3, "gate": 3, "review": 2 },

  "tiers": {
    "trivial": { "model": "claude-sonnet-5",  "effort": "low",    "gate": "fast", "review": false, "fanout": false },
    "small":   { "model": "claude-sonnet-5",  "effort": "medium", "gate": "fast", "review": true,  "fanout": false },
    "medium":  { "model": "claude-sonnet-5",  "effort": "high",   "gate": "full", "review": true,  "fanout": false },
    "large":   { "model": "claude-opus-5",    "effort": "xhigh",  "gate": "full", "review": true,  "fanout": true }
  }
}
