{
  "$schema": "../packages/engine/schemas/config.schema.json",
  "version": 1,
  "provider": {
    "name": "github",
    "module": "../providers/github/index.mjs",
    "options": {
      "owner": "Alejopl6",
      "repo": "noxloop",
      "childType": "Task",
      "childLabels": [
        "noxloop"
      ]
    },
    "stateMap": {
      "todo": "open",
      "in_progress": null,
      "blocked": null,
      "in_review": null,
      "done": null
    },
    "levelMap": {
      "Epic": "epic",
      "Feature": "feature",
      "Story": "story",
      "Task": "task",
      "Bug": "story",
      "default": "story"
    }
  },
  "forge": {
    "kind": "github",
    "cli": "gh"
  },
  "identity": {
    "assignee": "Alejopl6",
    "mention": "@noxloop"
  },
  "repos": {
    "noxloop": {
      "path": "~/proyects/noxloop",
      "remote": "https://github.com/Alejopl6/noxloop.git",
      "baseBranch": "main",
      "gate": "npm test && npm run typecheck && npm run validate",
      "fastGate": "npm test",
      "runners": {
        "node": "node --test {file}"
      },
      "env": {},
      "gaps": [
        "sin cobertura de e2e contra un gestor real"
      ]
    }
  },
  "limits": {
    "maxParallelTasks": 2,
    "maxParallelItems": 1,
    "maxCostUsd": 25,
    "phaseTimeoutMin": 30,
    "callsPerItem": 40,
    "stallRounds": 2,
    "pollIntervalSec": 180
  },
  "budgets": {
    "red": 2,
    "green": 3,
    "gate": 3,
    "review": 2
  },
  "tiers": {
    "trivial": {
      "model": "claude-haiku-4-5",
      "effort": "low",
      "gate": "fast",
      "review": false,
      "fanout": false
    },
    "small": {
      "model": "claude-sonnet-5",
      "effort": "medium",
      "gate": "fast",
      "review": true,
      "fanout": false
    },
    "medium": {
      "model": "claude-sonnet-5",
      "effort": "high",
      "gate": "full",
      "review": true,
      "fanout": false
    },
    "large": {
      "model": "claude-opus-5",
      "effort": "xhigh",
      "gate": "full",
      "review": true,
      "fanout": true
    }
  }
}
